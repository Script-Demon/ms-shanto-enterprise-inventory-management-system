# This folder holds user-uploaded files. Never execute anything in it —
# only serve it as static content.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .cgi .pl .py
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .cgi .pl .py
